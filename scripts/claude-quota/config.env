# claude-quota tunables. Percentages compare against the MAX of the
# 5-hour and 7-day utilization the account reports.
#
# WARN_PCT   `usage.sh check` returns nonzero at/above this (soft notice)
# SWAP_PCT   hook swaps the credentials FILE to the other account + warns;
#            the current turn is NOT interrupted
# BLOCK_PCT  hook swaps + hard-stops (exit 2): blocks the tool call / next
#            prompt so you stop burning the capped account
# CACHE_TTL      seconds a fetched usage payload stays fresh (hooks reuse it)
# CURL_TIMEOUT   seconds before a usage fetch gives up (fail-open on timeout)

WARN_PCT=80
SWAP_PCT=90
BLOCK_PCT=97
CACHE_TTL=60
CURL_TIMEOUT=8
