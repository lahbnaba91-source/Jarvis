{
  "name": "badge",
  "version": "0.1.0",
  "private": true,
  "description": "BADGE \u2014 personal radiation dose ledger for aircrew. P1\u2013P8.",
  "main": "engine/dose.js",
  "scripts": {
    "build": "engine/native/build.sh",
    "dose": "node cli.js dose",
    "log": "node --no-warnings cli.js log",
    "ledger": "node --no-warnings cli.js ledger",
    "verify": "node --no-warnings cli.js verify",
    "export": "node --no-warnings cli.js export",
    "validate": "node tests/validation/run-validation.js",
    "test:ledger": "node --no-warnings tests/ledger/run-ledger-tests.js",
    "test": "node tests/validation/run-validation.js && node --no-warnings tests/ledger/run-ledger-tests.js && node --no-warnings tests/spaceweather/run-spaceweather-tests.js && node --no-warnings tests/policy/run-policy-tests.js && node --no-warnings tests/api/run-api-tests.js && node --no-warnings tests/brief/run-brief-tests.js && node --no-warnings tests/telemetry/run-telemetry-tests.js && node --no-warnings tests/wearable/run-wearable-tests.js && node tests/physics/run-physics-tests.js",
    "spaceweather": "node --no-warnings cli.js spaceweather",
    "poll": "node --no-warnings spaceweather/poller.js",
    "test:spaceweather": "node --no-warnings tests/spaceweather/run-spaceweather-tests.js",
    "status": "node --no-warnings cli.js status",
    "test:policy": "node --no-warnings tests/policy/run-policy-tests.js",
    "start": "node --no-warnings server.js",
    "test:api": "node --no-warnings tests/api/run-api-tests.js",
    "brief": "node --no-warnings cli.js brief",
    "test:brief": "node --no-warnings tests/brief/run-brief-tests.js",
    "track": "node --no-warnings cli.js track",
    "test:telemetry": "node --no-warnings tests/telemetry/run-telemetry-tests.js",
    "test:wearable": "node --no-warnings tests/wearable/run-wearable-tests.js",
    "test:physics": "node tests/physics/run-physics-tests.js",
    "validate:altitude": "node --no-warnings tests/validation/run-altitude-validation.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
