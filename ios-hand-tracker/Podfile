# CocoaPods is the ONLY official distribution channel for
# MediaPipeTasksVision (no SPM support -- see README.md and
# HandLandmarkTypes.swift for the full reasoning, confirmed against the
# still-open google-ai-edge/mediapipe#5464 and #6167). This Podfile targets
# HandTrackerApp, the XcodeGen-generated project's app target -- run
# `xcodegen generate` BEFORE `pod install`, every time, since regenerating
# the .xcodeproj afterward would wipe CocoaPods' integration into it.

platform :ios, '16.0'
use_frameworks!

# HandTrackerAppTests is deliberately NOT listed here (not even with
# inherit!:search_paths, which was tried and reverted 2026-08-30). CocoaPods
# generates its own "Embed Frameworks" copy for ANY target it's told about,
# regardless of inherit mode -- with the test target ALSO getting its own
# copy of MediaPipeTasksVision's dynamic framework, dyld loaded the native
# (C++) code twice in one process and its global calculator registry
# aborted: "Function with name FlowLimiterCalculator already registered"
# (confirmed live in CI, alongside dyld's own "Class X is implemented in
# both..." warnings naming the app's binary AND the test bundle as the two
# copies). project.yml now sets TEST_HOST/BUNDLE_LOADER directly on
# HandTrackerAppTests instead -- that's what makes Xcode treat it as a
# genuinely hosted test (inheriting the host app's search paths for
# @testable import to resolve, and running against the ALREADY-loaded host
# binary instead of embedding a second copy). CocoaPods needs no
# involvement in the test target at all once that's set correctly.
target 'HandTrackerApp' do
  pod 'MediaPipeTasksVision'
end
