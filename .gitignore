# The vault now lives in its own repo (hq-vault), synced separately via
# GitHub Gitless Sync. Kept on disk here for the local AI session, not tracked.
HQ/

# ai-visualizer (vendored from jaredrhod/ai-visualizer, plus a Jarvis-specific
# voice-proxy patch and bind fix) IS tracked here as of 2026-08-29 — it used
# to be excluded entirely on the theory that update.sh would re-vendor it,
# but that patch and the bind fix lived ONLY on one machine's disk with no
# git history anywhere, and got silently lost on a fresh codespace. Its own
# ai-visualizer/.gitignore still excludes the personal config and runtime
# voice-state files; only the blanket top-level exclusion is gone.
.voice-bus/

# jarvis-voice: server.py is ours and tracked, but the venv and any
# recording scratch files are not.
jarvis-voice/.venv/
jarvis-voice/tmp/

# Hubspace light control: hubspace_light.py is ours and tracked, but the
# venv and the cached refresh-token (a live credential) are not.
scripts/hubspace/.venv/
scripts/hubspace/.state/

# Spotify playback control: spotify_play.py is ours and tracked, but the
# client secret and cached refresh-token (live credentials) are not.
scripts/spotify/.state/

# Light-show cue scheduler: analyze_track.py + the generated cues/*.json
# are ours and tracked (just timing/color metadata, no audio), but the
# per-run latency log and calibration result are local runtime state.
scripts/lightshow/state/

# barehands (vendored from jaredrhod/barehands, plus real Jarvis-specific
# gesture/customization work) IS tracked here as of 2026-08-29 — same
# reasoning as ai-visualizer above: it used to be excluded and rely on its
# own separate local git repo for history, but that repo had no remote, so a
# fresh codespace got the vanilla upstream version with none of the actual
# customization. Its own barehands/.gitignore still excludes barehands.json
# and the state/ runtime files; only the blanket top-level exclusion is gone.

# jarvis-voice: generated packaging metadata from `pip install -e .`, not
# source — regenerates on any fresh env.
jarvis-voice/jarvis_voice.egg-info/

# Claude Code local state: settings.local.json carries this machine's own
# permission allowlist, scheduled_tasks.lock is a live PID/session lock —
# both go stale the instant they're read on a different machine or session.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/sessions/

# Compiled Python bytecode cache — regenerates automatically, never source.
__pycache__/

.DS_Store

# pull-hq-vault.py's own hidden baseline clone -- a change-detection sensor,
# never the vault content itself (that stays HQ/, a plain copy on purpose).
.hq-vault-pull-sensor/
