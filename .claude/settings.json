{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /workspaces/Jarvis/.voice-bus /workspaces/Jarvis/barehands/state && echo idle > /workspaces/Jarvis/.voice-bus/.voice_state && printf idle > /workspaces/Jarvis/barehands/state/state"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspaces/Jarvis/scripts/claude-quota/hook.sh session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo thinking > /workspaces/Jarvis/.voice-bus/.voice_state && printf thinking > /workspaces/Jarvis/barehands/state/state"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspaces/Jarvis/scripts/claude-quota/hook.sh prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspaces/Jarvis/scripts/claude-quota/hook.sh tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo speaking > /workspaces/Jarvis/.voice-bus/.voice_state; printf speaking > /workspaces/Jarvis/barehands/state/state; nohup bash -c 'sleep 3; echo idle > /workspaces/Jarvis/.voice-bus/.voice_state; printf idle > /workspaces/Jarvis/barehands/state/state' >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  }
}
